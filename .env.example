# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=car_sale

# HTTP server
PORT=3000

# Sibling "core" service endpoint used to create a payment order when a sale is created.
# The core service is expected to later call back into this service's
# PATCH /sales/:id/payment-status endpoint once the payment is confirmed or cancelled.
PAYMENT_ORDER_SERVICE_URL=http://car-sales-core:3000/payment-order
